{
  "name": "orbit-task-manager",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/build-offline.mjs",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next",
    "test:projects": "node --experimental-strip-types --test tests/projects.test.mjs tests/project-progress.test.mjs tests/task-status.test.mjs tests/project-categories.test.mjs tests/inbox-orbits.test.mjs",
    "prebuild": "node scripts/prepare-offline-build.mjs",
    "test:offline": "node --experimental-strip-types --test tests/local-workspace.test.mjs tests/public-shell.test.mjs scripts/offline/offline.test.mjs scripts/offline/client.test.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "exceljs": "4.4.0",
    "lucide-react": "0.468.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
